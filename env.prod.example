# ============================================================
# PRODUCCIÓN — CreaBits Tutor con Supabase
# Copiar este archivo a .env y completar antes de:
#   docker compose -f docker-compose.prod.yml up -d --build
# ============================================================

# ── BASE DE DATOS (Supabase) ──────────────────────────────────────────────────
# 1. Abre tu proyecto en https://supabase.com
# 2. Ve a Settings → Database → Connection string
# 3. Selecciona "Session pooler" (puerto 5432) y copia la URI
# 4. Reemplaza [YOUR-PASSWORD] por tu contraseña de Supabase
#
# Formato esperado:
# postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── CORS (IP pública o dominio del servidor) ──────────────────────────────────
CORS_ORIGINS=http://207.244.241.125,http://localhost

# ── LLM ───────────────────────────────────────────────────────────────────────
# Opciones: mock (sin API, para pruebas) | gemini | openrouter
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── APP ───────────────────────────────────────────────────────────────────────
ADMIN_FINISH_CODE=99999
