ALTER TABLE public.eventos OWNER TO postgres;

--
-- Name: exportaciones; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.exportaciones (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    solicitado_por uuid,
    formato character varying(8) NOT NULL,
    alcance character varying(32) NOT NULL,
    filtros json NOT NULL,
    total_registros integer,
    archivo_path text,
    creado_en timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT ck_exportaciones_alcance CHECK (((alcance)::text = ANY ((ARRAY['sesiones'::character varying, 'mensajes'::character varying, 'feedback'::character varying, 'eventos'::character varying, 'dataset_completo'::character varying])::text[]))),
    CONSTRAINT ck_exportaciones_formato CHECK (((formato)::text = ANY ((ARRAY['json'::character varying, 'csv'::character varying])::text[]))),
    CONSTRAINT ck_exportaciones_total CHECK (((total_registros IS NULL) OR (total_registros >= 0)))
);


ALTER TABLE public.exportaciones OWNER TO postgres;

--
-- Name: feedback_sesion; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.feedback_sesion (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    sesion_id uuid NOT NULL,
    estudiante_id uuid NOT NULL,
    nivel_satisfaccion smallint NOT NULL,
    etiqueta text,
    comentario_extra text,
    creado_en timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT ck_feedback_nivel_satisfaccion CHECK (((nivel_satisfaccion >= 1) AND (nivel_satisfaccion <= 5)))
);


ALTER TABLE public.feedback_sesion OWNER TO postgres;

--
-- Name: grupos; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.grupos (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    nombre text NOT NULL,
    descripcion text,
    fecha_inicio date,
    fecha_fin date,
    activo boolean DEFAULT true NOT NULL,
    creado_en timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.grupos OWNER TO postgres;

--
-- Name: juegos; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.juegos (
    id text NOT NULL,
    categoria_id text,
    titulo text NOT NULL,
    icono text,
    descripcion_corta text,
    duracion_estimada_min smallint,
    es_proyecto_libre boolean DEFAULT false NOT NULL,
    activo boolean DEFAULT true NOT NULL,
    creado_en timestamp with time zone DEFAULT now() NOT NULL,
    url_video character varying,
    descripcion_solucion text,
    bloques_clave text
);


ALTER TABLE public.juegos OWNER TO postgres;

--
-- Name: mensajes; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.mensajes (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    conversacion_id uuid NOT NULL,
    sesion_id uuid NOT NULL,
    estudiante_id uuid NOT NULL,
    rol character varying(16) NOT NULL,
    contenido text NOT NULL,
    orden_mensaje integer NOT NULL,
    creado_en timestamp with time zone DEFAULT now() NOT NULL,
    proveedor_llm text,
    modelo_llm text,
    prompt_version text,
    input_tokens integer,
    output_tokens integer,
    metadata json NOT NULL,
    CONSTRAINT ck_mensajes_input_tokens CHECK (((input_tokens IS NULL) OR (input_tokens >= 0))),
    CONSTRAINT ck_mensajes_output_tokens CHECK (((output_tokens IS NULL) OR (output_tokens >= 0))),
    CONSTRAINT ck_mensajes_rol CHECK (((rol)::text = ANY ((ARRAY['nino'::character varying, 'tutor'::character varying, 'sistema'::character varying])::text[])))
);


ALTER TABLE public.mensajes OWNER TO postgres;

--
-- Name: sesiones; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.sesiones (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    estudiante_id uuid NOT NULL,
    grupo_id uuid,
    inicio_en timestamp with time zone DEFAULT now() NOT NULL,
    fin_en timestamp with time zone,
    asentimiento_aceptado boolean DEFAULT false NOT NULL,
    dispositivo_tipo text,
    estado character varying(16) DEFAULT 'activa'::character varying NOT NULL,
    modo_llm character varying(16) DEFAULT 'mock'::character varying NOT NULL,
    metadata json NOT NULL,
    CONSTRAINT ck_sesiones_estado CHECK (((estado)::text = ANY ((ARRAY['activa'::character varying, 'cerrada'::character varying, 'abandonada'::character varying, 'anulada'::character varying])::text[])))
);


ALTER TABLE public.sesiones OWNER TO postgres;

--
-- Name: usuarios_app; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.usuarios_app (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    email text NOT NULL,
    nombre_completo text NOT NULL,
    rol character varying(32) NOT NULL,
    grupo_id uuid,
    activo boolean DEFAULT true NOT NULL,
    creado_en timestamp with time zone DEFAULT now() NOT NULL,
    ultimo_acceso_en timestamp with time zone,
    CONSTRAINT ck_usuarios_app_rol CHECK (((rol)::text = ANY ((ARRAY['researcher'::character varying, 'teacher'::character varying, 'technical_admin'::character varying, 'super_admin'::character varying])::text[])))
);


ALTER TABLE public.usuarios_app OWNER TO postgres;

--
-- Name: versiones_juego; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.versiones_juego (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    juego_id text NOT NULL,
    version text NOT NULL,
    instruccion_nino text NOT NULL,
    objetivos_pedagogicos json NOT NULL,
    pistas_progresivas json NOT NULL,
    criterios_completado json NOT NULL,
    preguntas_frecuentes_esperadas json NOT NULL,
    system_prompt text NOT NULL,
    activo boolean DEFAULT true NOT NULL,
    creado_en timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.versiones_juego OWNER TO postgres;

--
-- Name: messages; Type: TABLE; Schema: realtime; Owner: supabase_realtime_admin
--

CREATE TABLE realtime.messages (
    topic text NOT NULL,
    extension text NOT NULL,
    payload jsonb,
    event text,
    private boolean DEFAULT false,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    inserted_at timestamp without time zone DEFAULT now() NOT NULL,
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    binary_payload bytea
)
PARTITION BY RANGE (inserted_at);


ALTER TABLE realtime.messages OWNER TO supabase_realtime_admin;

--
-- Name: schema_migrations; Type: TABLE; Schema: realtime; Owner: supabase_admin
--

CREATE TABLE realtime.schema_migrations (
    version bigint NOT NULL,
    inserted_at timestamp(0) without time zone
);


ALTER TABLE realtime.schema_migrations OWNER TO supabase_admin;

--
-- Name: subscription; Type: TABLE; Schema: realtime; Owner: supabase_realtime_admin
--

CREATE TABLE realtime.subscription (
    id bigint NOT NULL,
    subscription_id uuid NOT NULL,
    entity regclass NOT NULL,
    filters realtime.user_defined_filter[] DEFAULT '{}'::realtime.user_defined_filter[] NOT NULL,
    claims jsonb NOT NULL,
    claims_role regrole GENERATED ALWAYS AS (realtime.to_regrole((claims ->> 'role'::text))) STORED NOT NULL,
    created_at timestamp without time zone DEFAULT timezone('utc'::text, now()) NOT NULL,
    action_filter text DEFAULT '*'::text,
    selected_columns text[],
    CONSTRAINT subscription_action_filter_check CHECK ((action_filter = ANY (ARRAY['*'::text, 'INSERT'::text, 'UPDATE'::text, 'DELETE'::text])))
);


ALTER TABLE realtime.subscription OWNER TO supabase_realtime_admin;

--
-- Name: subscription_id_seq; Type: SEQUENCE; Schema: realtime; Owner: supabase_realtime_admin
--

ALTER TABLE realtime.subscription ALTER COLUMN id ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME realtime.subscription_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: buckets; Type: TABLE; Schema: storage; Owner: supabase_storage_admin
--

CREATE TABLE storage.buckets (
    id text NOT NULL,
    name text NOT NULL,
    owner uuid,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    public boolean DEFAULT false,
    avif_autodetection boolean DEFAULT false,
    file_size_limit bigint,
    allowed_mime_types text[],
    owner_id text,
    type storage.buckettype DEFAULT 'STANDARD'::storage.buckettype NOT NULL
);


ALTER TABLE storage.buckets OWNER TO supabase_storage_admin;

