    CONSTRAINT ck_conversaciones_estado CHECK (((estado)::text = ANY ((ARRAY['activa'::character varying, 'cerrada'::character varying, 'abandonada'::character varying])::text[])))
);


ALTER TABLE public.conversaciones OWNER TO postgres;

--
-- Name: estudiantes; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.estudiantes (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    codigo_publico text NOT NULL,
    grupo_id uuid,
    nombre_completo text,
    email_referencia text,
    notas_investigador text,
    edad smallint,
    genero_opcion character varying(32),
    experiencia_scratch character varying(32),
    experiencia_ia character varying(32),
    activo boolean DEFAULT true NOT NULL,
    creado_en timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT ck_estudiantes_experiencia_ia CHECK (((experiencia_ia IS NULL) OR ((experiencia_ia)::text = ANY ((ARRAY['ninguna'::character varying, 'alguna'::character varying, 'frecuente'::character varying])::text[])))),
    CONSTRAINT ck_estudiantes_experiencia_scratch CHECK (((experiencia_scratch IS NULL) OR ((experiencia_scratch)::text = ANY ((ARRAY['ninguna'::character varying, 'un_poco'::character varying, 'mucha'::character varying])::text[])))),
    CONSTRAINT ck_estudiantes_genero CHECK (((genero_opcion IS NULL) OR ((genero_opcion)::text = ANY ((ARRAY['femenino'::character varying, 'masculino'::character varying, 'prefiero_no_decir'::character varying, 'otro'::character varying])::text[]))))
);


ALTER TABLE public.estudiantes OWNER TO postgres;

--
