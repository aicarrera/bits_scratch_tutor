# Copiar este archivo a .env y completar antes de hacer docker compose up
# Este archivo SI puede subirse a git (no tiene secretos reales)

# Password de PostgreSQL local (elige uno seguro)
DB_PASSWORD=BDScratch

# IP publica o dominio del servidor
CORS_ORIGINS=http://207.244.241.125,http://localhost

# LLM: mock (sin API key) | gemini | openrouter
LLM_MODE=mock
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# PIN para cerrar sesiones desde el panel admin
ADMIN_FINISH_CODE=99999
